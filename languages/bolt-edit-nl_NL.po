msgstr "Route 1"

#: includes/class-bolt-edit-admin.php:307
msgid "Start from an idea"
msgstr "Begin met een idee"

#: includes/class-bolt-edit-admin.php:308
msgid "Describe the website and let your agent design and build the complete theme from scratch."
msgstr "Beschrijf de website en laat je assistent het complete thema vanaf nul ontwerpen en bouwen."

#: includes/class-bolt-edit-admin.php:309 includes/class-bolt-edit-admin.php:320
msgid "Prompt copied"
msgstr "Prompt gekopieerd"

#: includes/class-bolt-edit-admin.php:310
